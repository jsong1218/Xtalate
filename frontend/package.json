{
  "name": "xtalate-frontend",
  "version": "0.7.0",
  "private": true,
  "description": "Xtalate Web UI — a faithful presentation layer over the /v1 service (MASTER_SPEC Part 7).",
  "scripts": {
    "gen:api": "openapi-typescript ../docs/openapi.json -o lib/api/schema.d.ts",
    "postinstall": "npm run gen:api",
    "predev": "npm run gen:api",
    "dev": "next dev -H ${XTALATE_DEV_HOST:-127.0.0.1}",
    "prebuild": "npm run gen:api",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "next": "^15.0.0",
    "openapi-fetch": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^24.1.1",
    "openapi-typescript": "^7.3.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "js-yaml": "^4.3.1",
    "vite": "^6.4.3",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}
