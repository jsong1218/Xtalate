{
  "name": "xtalate-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Xtalate Web UI — a faithful presentation layer over the /v1 service (MASTER_SPEC Part 7).",
  "scripts": {
    "gen:api": "openapi-typescript ../docs/openapi.json -o lib/api/schema.d.ts",
    "postinstall": "npm run gen:api",
    "predev": "npm run gen:api",
    "dev": "next dev -H ${XTALATE_DEV_HOST:-127.0.0.1}",
    "prebuild": "npm run gen:api",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "molstar": "5.11.0",
    "next": "^16.3.5",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.3.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4",
    "js-yaml": "^4.3.2",
    "vite": "^6.4.3",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}
