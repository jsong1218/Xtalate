{
  "name": "xtalate-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Xtalate Web UI — a faithful presentation layer over the /v1 service (MASTER_SPEC Part 7).",
  "scripts": {
    "gen:api": "openapi-typescript ../docs/openapi.json -o lib/api/schema.d.ts",
    "postinstall": "npm run gen:api",
    "predev": "npm run gen:api",
    "dev": "next dev -H ${XTALATE_DEV_HOST:-127.0.0.1}",
    "prebuild": "npm run gen:api",
    "build": "next build",
    "size": "node scripts/size-budget.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "^1.79.0",
    "molstar": "5.13.1",
    "next": "^16.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.3.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "js-yaml": "^4.3.2",
    "vite": "^6.4.4",
    "esbuild": "^0.25.0",
    "postcss-selector-parser": "^6.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
