          "level": "partial",
          "notes": "Written as momenta; unit-converted."
        },
        "electronic.charges": {
          "level": "partial",
          "notes": "Written as the initial_charges array."
        },
        "electronic.magnetic_moments": {
          "level": "partial",
          "notes": "Written as the initial_magmoms array."
