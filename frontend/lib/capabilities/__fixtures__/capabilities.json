  "cif": {
    "read": {
      "allows_open_boundaries": false,
      "direction": "read",
      "fields": {
        "atoms.positions": {
          "level": "full",
          "notes": null
        },
        "atoms.symbols": {
          "level": "full",
          "notes": "From _atom_site_type_symbol (oxidation-state suffix split off) or _atom_site_label; the raw type symbol is preserved per-atom."
        },
        "cell.lattice_vectors": {
          "level": "full",
          "notes": "Built from _cell_length_* / _cell_angle_* with a\u2248+x and b in the xy half-plane (crystallographic standard orientation)."
        },
        "cell.pbc": {
          "level": "partial",
          "notes": "Always (T,T,T) by format definition; CIF carries no explicit PBC."
        },
        "cell.space_group": {
          "level": "full",
          "notes": "Hermann-Mauguin or Hall symbol exactly as declared; never derived."
        },
        "electronic.charges": {
          "level": "partial",
          "notes": "Only formal oxidation states, from a complete _atom_type_oxidation_number loop; labelled 'formal_oxidation_state' in simulation.extra. A partial declaration leaves the field unset."
        },
        "simulation.extra": {
          "level": "full",
          "notes": "Bibliographic and free-text block tags carried verbatim."
        },
        "user_metadata.custom_per_atom": {
          "level": "full",
          "notes": "Unmapped _atom_site columns (Wyckoff symbols, displacement parameters) carried verbatim under 'cif:' keys, plus occupancy under 'cif:occupancy'."
        }
      },
      "format_id": "cif",
      "format_name": "Crystallographic Information File",
      "lossy_notes": [
        "Only the first data_ block is read; further blocks are independent structures and are named in a warning, never silently skipped.",
        "Declared symmetry operations are applied, so atoms are the full cell, not the asymmetric unit; generated coordinates are wrapped into the cell and images coinciding within 0.05 \u00c5 are merged (Part 3 \u00a73 n.13).",
        "A non-P 1 symbol declared with no operation loop is refused, not guessed from a space-group table.",
        "Occupancy is carried as a custom per-atom array under 'cif:occupancy', not modelled as a canonical field, and warns at parse (Part 3 \u00a73 n.11).",
        "A type symbol's oxidation-state suffix ('Fe3+') is preserved verbatim but is not read as a charge; only a declared _atom_type_oxidation_number populates electronic.charges."
      ],
      "max_frames": 1,
      "native_coordinate_system": "fractional",
      "numeric_precision": {},
      "representable_constraint_kinds": [],
      "required_fields": [],
      "writable_custom_key_pattern": {},
      "writable_custom_keys": {}
    },
    "write": {
      "allows_open_boundaries": false,
      "direction": "write",
      "fields": {
        "atoms.positions": {
          "level": "full",
          "notes": "Written as fractional _atom_site_fract_* against the cell."
        },
        "atoms.symbols": {
          "level": "full",
          "notes": null
        },
        "cell.lattice_vectors": {
          "level": "full",
          "notes": "Written as _cell_length_* / _cell_angle_* parameters; lengths and angles are orientation-independent, so the cell is preserved exactly even though its absolute orientation in the lab frame is not a CIF concept."
        },
        "cell.pbc": {
          "level": "partial",
          "notes": "CIF describes a crystal, so periodicity is implied and never written; only fully periodic (T,T,T) is representable."
        },
        "cell.space_group": {
          "level": "none",
          "notes": "Xtalate writes the identity operation and the full explicit atom list, with no space-group symbol, because the Canonical Object holds the expanded cell; a source symbol would assert a setting the written coordinates no longer encode, and re-deriving one from coordinates is a Non-Goal."
        },
        "dynamics.constraints": {
          "level": "none",
          "notes": null
        },
        "dynamics.forces": {
          "level": "none",
          "notes": null
        },
        "dynamics.velocities": {
          "level": "none",
          "notes": null
        },
        "electronic.charges": {
          "level": "none",
          "notes": "CIF states charges per atom *type* (_atom_type_oxidation_number), not per atom; writing the canonical per-atom array back is a v0.4 cut-line item."
        },
        "electronic.magnetic_moments": {
          "level": "none",
          "notes": null
        },
        "electronic.stress": {
          "level": "none",
          "notes": null
        },
        "electronic.total_energy": {
          "level": "none",
          "notes": null
        },
        "simulation.extra": {
          "level": "partial",
          "notes": "Keys prefixed 'cif:' are written back as the block-level tags they came from; other keys have no CIF tag spelling and are dropped. Two families are held back deliberately: the declared symmetry operations, and any tag that identifies a space group \u2014 its International Tables number or a database's own symbol spelling \u2014 because the written atom list is the expanded full cell and a reader honouring either would expand it a second time. A tag naming only the crystal system is kept."
        },
        "user_metadata.custom_global": {
          "level": "partial",
          "notes": "Only the data block name (cif:data_block_name)."
        },
        "user_metadata.custom_per_atom": {
          "level": "partial",
          "notes": "Site label, raw type symbol and occupancy are written back to their _atom_site columns; other per-atom columns (Wyckoff symbols, displacement parameters) are not re-emitted in v0.4."
        },
        "user_metadata.custom_per_frame": {
          "level": "none",
          "notes": null
        }
      },
      "format_id": "cif",
      "format_name": "Crystallographic Information File",
      "lossy_notes": [
        "Written with the identity symmetry operation and every atom listed explicitly; no space-group symbol is emitted, and a source symbol is reported removed rather than echoed.",
        "Cartesian positions are converted to fractional against the cell on write, so sub-ulp differences from the source Cartesian values are possible on round-trip."
      ],
      "max_frames": 1,
      "native_coordinate_system": "fractional",
      "numeric_precision": {},
      "representable_constraint_kinds": [],
      "required_fields": [
        "atoms.symbols",
        "atoms.positions",
        "cell.lattice_vectors"
      ],
      "writable_custom_key_pattern": {},
      "writable_custom_keys": {
        "user_metadata.custom_global": [
          "cif:data_block_name"
        ],
        "user_metadata.custom_per_atom": [
          "cif:atom_site_label",
          "cif:type_symbol",
          "cif:occupancy"
        ]
      }
    }
  },
