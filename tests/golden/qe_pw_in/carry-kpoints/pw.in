&CONTROL
   calculation = 'scf', ecutwfc = 40.0, ecutrho = 320.0,
/
&SYSTEM
   ibrav = 0, nat = 2, ntyp = 2,
   smearing = 'gaussian', occupations = 'smearing',
   nspin = 2,
/
